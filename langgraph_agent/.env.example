# --- Existing ---
DATABASE_URL=""
GROQ_API_KEY=""

# --- New: required for the FAQ / Workflow #3 knowledge (RAG) path ---
# Property search (MCP) and the UNCLEAR/clarify paths work without these.
GOOGLE_API_KEY=""          # Gemini embeddings -- same provider used for Cubot
PINECONE_API_KEY=""        # Pinecone vector DB
PINECONE_INDEX_NAME=""     # optional, defaults to "elarion-faq" if unset
PINECONE_NAMESPACE=""      # optional, defaults to "policy-docs" if unset

# --- New: required for whatsapp_server.py (WhatsApp input channel, Meta Cloud API) ---
# All from Meta for Developers > your App > WhatsApp > API Setup.
# For testing: Meta gives a free test number, a temporary access token, and
# lets you add up to 5 free test recipient numbers -- no payment needed yet.
WHATSAPP_ACCESS_TOKEN=""      # temporary token from API Setup (regenerate as it expires while testing)
WHATSAPP_PHONE_NUMBER_ID=""   # from the same API Setup page
WHATSAPP_APP_SECRET=""        # App Dashboard > Settings > Basic -- used to verify inbound webhook signatures
WHATSAPP_VERIFY_TOKEN=""      # any string you choose; enter the same value when configuring the webhook in the App Dashboard
WHATSAPP_API_VERSION="v25.0"  # optional, defaults to v25.0 if unset (matches Meta's current version)
VALIDATE_META_SIGNATURE="true"  # keep "true" always; only ever set "false"
                                  # for a throwaway local debugging session

# --- New: alerting + rate limiting for whatsapp_server.py ---
TEAM_ALERT_WEBHOOK_URL=""              # Slack incoming-webhook URL. If a reply to a tenant
                                        # fails to send, the team gets pinged here instead of
                                        # it only showing up in a log nobody's watching.
                                        # Leave blank to just log a CRITICAL line instead.
WHATSAPP_RATE_LIMIT_MAX_MESSAGES="10"  # optional, defaults to 10 if unset
WHATSAPP_RATE_LIMIT_WINDOW_SECONDS="60"  # optional, defaults to 60 if unset
