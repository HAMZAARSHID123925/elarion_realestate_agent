# --- Database & LLM ---
DATABASE_URL="postgresql://postgres:password@localhost:5432/realestate"
GROQ_API_KEY=""

# --- Unified REST API Server Configuration (Phase 4 & 6) ---
API_PORT="8080"
API_HOST="0.0.0.0"

# --- Security & Authentication (Phase 6) ---
ENABLE_API_AUTH="false"                # Set "true" in staging/prod to enforce API-key auth
API_KEYS_ADMIN=""                     # Comma-separated admin API keys (full access)
API_KEYS_SERVICE=""                   # Comma-separated service API keys (workflow/pipeline)
API_KEYS_READONLY=""                  # Comma-separated read-only API keys

# --- Abuse Protection & Rate Limiting (Phase 6) ---
ENABLE_RATE_LIMIT="true"              # Enables token-bucket rate limiter middleware
RATE_LIMIT_PER_MINUTE="60"            # Allowed requests per minute per IP / API key
MAX_PAYLOAD_BYTES="2097152"           # Max request body size in bytes (default 2 MB)

# --- CORS Configuration (Phase 6) ---
CORS_ORIGINS="http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000,http://127.0.0.1:8080"

# --- Structured Logging & Observability (Phase 6) ---
LOG_FORMAT="text"                     # Set to "json" in production for structured JSON logs
LOG_LEVEL="INFO"                      # DEBUG, INFO, WARNING, ERROR, CRITICAL

# --- Background Scheduling (Phase 5 & 6) ---
ENABLE_BACKGROUND_SCHEDULER="false"   # Keep "false" on multi-worker API; run standalone scheduler worker

# --- Knowledge & FAQ (Workflow #3, RAG) ---
GOOGLE_API_KEY=""                     # Gemini embeddings
PINECONE_API_KEY=""                   # Pinecone vector DB
PINECONE_INDEX_NAME="elarion-faq"
PINECONE_NAMESPACE="policy-docs"

# --- Inbound Channel: WhatsApp (Meta Graph API) ---
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_APP_SECRET=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_API_VERSION="v25.0"
VALIDATE_META_SIGNATURE="true"
WHATSAPP_RATE_LIMIT_MAX_MESSAGES="10"
WHATSAPP_RATE_LIMIT_WINDOW_SECONDS="60"

# --- Inbound Channel: Email (Resend API) ---
RESEND_API_KEY=""
RESEND_WEBHOOK_SECRET=""
FROM_EMAIL_ADDRESS="support@elarion.com"
EMAIL_SERVER_PORT="8002"
VALIDATE_EMAIL_SIGNATURE="true"
EMAIL_RATE_LIMIT_MAX_MESSAGES="10"
EMAIL_RATE_LIMIT_WINDOW_SECONDS="60"

# --- Lease Expiry Tracking (Workflow #4) ---
LEASE_EXPIRY_WINDOWS="90,60,30,7"
LEASE_EXPIRY_SCAN_TIMEZONE="UTC"

# --- Alerts & Notifications ---
TEAM_ALERT_WEBHOOK_URL=""
